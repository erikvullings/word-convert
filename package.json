{
  "name": "wordconvert",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @wordconvert/web build",
    "assets:formula-ocr": "node scripts/prepare-formula-ocr-assets.mjs",
    "benchmark:formula:generate": "node scripts/generate-formula-benchmark-corpus.mjs",
    "benchmark:formula:run": "node scripts/run-formula-benchmark-browser.mjs",
    "benchmark:formula:report": "node scripts/formula-benchmark.mjs tests/fixtures/formula-benchmark/corpus.json documentation/formula-benchmarks/rapid-latex-ocr-run.json documentation/formula-benchmarks/rapid-latex-ocr-report.json",
    "dev": "pnpm --filter @wordconvert/web dev",
    "fixtures:generate": "node scripts/generate-docx-fixtures.mjs",
    "fixtures:pdf": "node scripts/generate-pdf-fixtures.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings .",
    "static:check": "node scripts/verify-static-build.mjs",
    "test": "vitest run",
    "test:heron": "WORDCONVERT_TEST_HERON_MODEL=1 vitest run apps/web/src/worker/heron-layout-detector.model.test.ts",
    "test:formula-ocr": "WORDCONVERT_TEST_FORMULA_MODEL=1 vitest run apps/web/src/worker/formula-recognizer.model.test.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,json,css,html,md,yaml,yml}": "prettier --write"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "katex": "^0.16.47",
    "lint-staged": "^17.4.1",
    "oxlint": "^1.80.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "puppeteer-core": "^24.43.1",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
